# Runtime environment
# Copy to .env and fill in. Never commit the real .env.

# --- Application ----------------------------------------------------------
APP_ENV=production
# Generate with: python -m app.cli generate-secret  (or: flask generate-secret)
SECRET_KEY=
JWT_SECRET_KEY=
# PUBLIC_BASE_URL of the deployment, used in transactional emails
SITE_URL=https://harmony.example.com
LOG_LEVEL=INFO
LOG_FORMAT=json
ACCESS_TOKEN_TTL_SECONDS=43200
REFRESH_TOKEN_TTL_SECONDS=2592000

# --- Database (PostgreSQL) ------------------------------------------------
# Use a dedicated user; do not run the app as a superuser.
DATABASE_URL=postgresql+psycopg://harmony:HARMONY_DB_PASSWORD@db:5432/harmony
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_STATEMENT_TIMEOUT_MS=8000

# --- Cache and task queue (Redis) ------------------------------------------
REDIS_URL=redis://redis:6379/0
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=60
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
SOCKETIO_MESSAGE_QUEUE=redis://redis:6379/3

# --- HTTP and TLS ---------------------------------------------------------
# comma-separated allowlist of browser origins
CORS_ORIGINS=https://harmony.example.com
# Trust exactly the number of proxies in front of the app.
# Getting this wrong causes a redirect loop (too low) or IP spoofing (too high).
TRUSTED_PROXY_COUNT=1
FORCE_HTTPS=true
SECURE_COOKIE=true
HSTS_MAX_AGE_SECONDS=31536000
HSTS_PRELOAD=false
COOKIE_SAMESITE=Lax
# 8 MB is plenty for a few text posts; uploads are capped separately
MAX_CONTENT_LENGTH=12582912

# --- Security -------------------------------------------------------------
# bcrypt cost factor. 12 ≈ 250 ms on modern hardware; raise as hardware allows.
BCRYPT_ROUNDS=12
# Additional secret mixed into token digests. Rotating it invalidates all
# outstanding recovery links and, for the refresh cookie, all sessions.
TOKEN_PEPPER=
IP_HASH_SALT=
CSRF_PROTECTION=true

# --- Rate limits ----------------------------------------------------------
RATE_LIMIT_ENABLED=true
# format: <count>/<period>[;<count>/<period>...]
RATE_LIMIT_DEFAULT=1200/hour
RATE_LIMIT_LOGIN=10/minute;5/hour
RATE_LIMIT_REGISTER=5/hour;20/day
RATE_LIMIT_POST_CREATE=20/hour
RATE_LIMIT_COMMENT_CREATE=60/hour
RATE_LIMIT_SEARCH=120/hour
RATE_LIMIT_CHAT_SEND=120/minute
RATE_LIMIT_UPLOAD=30/hour
RATE_LIMIT_TRUST_PROXY=true

# --- Spam and bot protection ---------------------------------------------
# proof_of_work (self-hosted, no third party) | turnstile | recaptcha
CAPTCHA_PROVIDER=proof_of_work
CAPTCHA_ENABLED=true
CAPTCHA_POW_BITS=18
CAPTCHA_MIN_SOLVE_MS=120
# Only needed when CAPTCHA_PROVIDER is turnstile/recaptcha
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Optional: path to a newline-delimited word list (one per line, # comments)
MODERATION_DICTIONARY_PATH=

# --- Content moderation ---------------------------------------------------
# local | openai | custom
MODERATION_PROVIDER=local
MODERATION_ENABLED=true
MODERATION_FAIL_CLOSED=false
MODERATION_BLOCK_THRESHOLD=0.85
MODERATION_REVIEW_THRESHOLD=0.55
# For provider=openai
MODERATION_API_URL=https://api.openai.com/v1/moderations
MODERATION_API_KEY=
MODERATION_MODEL=omni-moderation-latest
MODERATION_TIMEOUT=4
# For provider=custom
# MODERATION_API_URL=https://moderation.internal/v1/check

# --- Uploads --------------------------------------------------------------
UPLOAD_DIR=/app/uploads
# Nginx serves this directory in production; set SERVE_UPLOADS=false so Flask
# does not also try to handle those requests.
SERVE_UPLOADS=false
UPLOAD_MAX_BYTES=8388608
UPLOAD_MAX_DIMENSION=2560
UPLOAD_THUMB_DIMENSION=640
UPLOAD_STRIP_EXIF=true
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp,image/gif

# --- Email ----------------------------------------------------------------
MAIL_ENABLED=true
# smtp | console | disabled
MAIL_BACKEND=smtp
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@harmony.example.com
MAIL_FROM_NAME=Гармония
MAIL_TIMEOUT=10

# --- WebSocket ------------------------------------------------------------
# gevent + a Redis message queue is what allows horizontal scaling.
SOCKETIO_ASYNC_MODE=gevent
SOCKETIO_CORS_ALLOWED_ORIGINS=https://harmony.example.com

# --- Privacy and retention -----------------------------------------------
PRIVACY_CONTROLLER_EMAIL=privacy@example.com
DPO_EMAIL=dpo@example.com
DATA_RETENTION_DAYS=365
ACCOUNT_DELETION_GRACE_DAYS=14
CHAT_RETENTION_DAYS=365
NOTIFICATION_RETENTION_DAYS=90

# --- Observability --------------------------------------------------------
METRICS_ENABLED=true
SLOW_REQUEST_MS=1200
# Required for multi-process Prometheus metrics
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus

# --- Bootstrap administrator (created only if no admin exists) ------------
ADMIN_EMAIL=
ADMIN_USERNAME=admin
# Minimum 12 characters; leave empty to skip bootstrap entirely.
ADMIN_PASSWORD=

# --- Limits ---------------------------------------------------------------
FEED_PAGE_SIZE=15
COMMENT_PAGE_SIZE=20
MAX_COMMENT_DEPTH=3
POST_MAX_CHARS=5000
MAX_POST_IMAGES=4
USERNAME_MIN_LENGTH=3
USERNAME_MAX_LENGTH=32
PASSWORD_MIN_LENGTH=10

# --- Media storage (Cloudflare R2, DigitalOcean Spaces, MinIO, S3) --------
# Leave S3_BUCKET empty to keep media on a local disk, which is the default and
# needs no account. Setting it switches `app/services/storage.py` to the
# bucket; the storage keys are identical either way, so nothing is migrated.
#
# pip install "boto3>=1.35,<2"   # only needed once S3_BUCKET is set
#
# S3_BUCKET=harmony-media
# Cloudflare R2: S3_REGION=auto, endpoint https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_ENDPOINT_URL=https://
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_KEY_PREFIX=
#
# Public base for media URLs. Cloudflare R2's public development URL looks like
# https://pub-<bucket>.r2.dev and is rate limited; a custom domain is better.
# Without this the service issues presigned URLs, which expire - acceptable
# while developing, wrong for a URL stored permanently in a post.
# S3_PUBLIC_BASE_URL=https://pub-harmony-media.r2.dev
# S3_PRESIGN_TTL_SECONDS=2592000
